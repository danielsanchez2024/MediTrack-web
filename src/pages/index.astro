---
import Layout from '../layouts/Layout.astro';
import LandingNav from '../components/landing/LandingNav';
import HeroDemo from '../components/landing/HeroDemo';
import FeatureTabs from '../components/landing/FeatureTabs';
import Faq from '../components/landing/Faq';
import SessionRedirect from '../components/landing/SessionRedirect';
import {
	ArrowRight,
	Camera,
	CalendarCheck,
	CircleCheck,
	Lock,
	ShieldCheck,
	HandHeart,
	EyeOff,
	Users,
	FileHeart,
	Smartphone,
	Crop
} from 'lucide-react';

const steps = [
	{
		icon: Camera,
		title: 'Agrega tu tratamiento',
		text: 'Fotografía tu fórmula médica o escribe el medicamento. Tú revisas lo que detectamos antes de guardarlo.'
	},
	{
		icon: CalendarCheck,
		title: 'Recibe tu calendario',
		text: 'Calculamos las tomas según la frecuencia y la duración, y te avisamos antes de cada dosis.'
	},
	{
		icon: CircleCheck,
		title: 'Registra y mira tu progreso',
		text: 'Marca cada toma en un toque y sigue tu adherencia. Tu cuidador, si lo autorizaste, también puede ayudarte.'
	}
];

const trust = [
	{ icon: ShieldCheck, label: 'Datos de salud con tu consentimiento' },
	{ icon: FileHeart, label: 'Catálogo oficial INVIMA' },
	{ icon: Users, label: 'Modo cuidador' },
	{ icon: Smartphone, label: 'Cómodo desde el celular' }
];

const privacy = [
	{ icon: EyeOff, title: 'No guardamos la foto', text: 'Solo conservamos los medicamentos que tú revisas y confirmas.' },
	{ icon: Crop, title: 'Tú decides qué sale de tu teléfono', text: 'Recorta la foto para enviar solo las líneas de los medicamentos, sin tu nombre ni tu documento.' },
	{ icon: HandHeart, title: 'Tus datos, tus permisos', text: 'Un cuidador solo ve tu información si tú lo autorizas, y puedes retirar el permiso cuando quieras.' },
	{ icon: Lock, title: 'Nunca vendemos tus datos', text: 'No los usamos para publicidad ni los cedemos con fines comerciales.' }
];
---

<Layout
	title="MediTrack — Nunca olvides una dosis"
	description="Organiza tus medicamentos, recibe recordatorios a tiempo y cuida de tu familia. Escanea tu fórmula médica y lleva el control de cada toma."
>
	<script is:inline>
		// Marks the page so sections start hidden ONLY when JavaScript can reveal them again.
		document.documentElement.classList.add('js-reveal');
	</script>

	<SessionRedirect client:load />
	<LandingNav client:load />

	<main class="overflow-x-clip">
		<!-- HERO -->
		<section class="relative isolate overflow-hidden pt-28 pb-20 sm:pt-32 lg:pb-28">
			<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
				<div class="absolute inset-0 bg-linear-to-b from-surface-info via-surface to-surface"></div>
				<div class="anim-blob absolute -left-24 top-10 h-80 w-80 rounded-full bg-secondary/20 blur-3xl"></div>
				<div class="anim-blob absolute -right-20 top-40 h-96 w-96 rounded-full bg-primary/15 blur-3xl" style="animation-delay: -6s"></div>
			</div>

			<div class="mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-2">
				<div class="text-center lg:text-left">
					<span class="reveal inline-flex items-center gap-2 rounded-full border border-primary/15 bg-white/80 px-4 py-1.5 text-xs font-bold text-primary shadow-sm backdrop-blur">
						<span class="h-2 w-2 rounded-full bg-secondary"></span>
						Tu salud, a tiempo
					</span>
					<h1 class="reveal mt-5 text-balance text-4xl font-bold leading-[1.1] tracking-tight text-text sm:text-5xl lg:text-6xl" style="--reveal-delay: 80ms">
						Nunca más olvides <span class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent">una dosis</span>
					</h1>
					<p class="reveal mx-auto mt-5 max-w-xl text-lg leading-relaxed text-text-secondary lg:mx-0" style="--reveal-delay: 160ms">
						Organiza tus medicamentos, recibe recordatorios justo a tiempo y cuida también de los tuyos. Escanea tu fórmula médica y
						MediTrack arma el calendario por ti.
					</p>
					<div class="reveal mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start" style="--reveal-delay: 240ms">
						<a
							href="/register"
							class="group flex h-13 items-center gap-2 rounded-xl bg-primary px-7 text-[15px] font-bold text-white shadow-lg shadow-primary/30 transition-all hover:-translate-y-0.5 hover:bg-primary-hover"
						>
							Crear mi cuenta
							<ArrowRight className="h-4 w-4 transition-transform group-hover:translate-x-1" strokeWidth={2.5} />
						</a>
						<a
							href="#como-funciona"
							class="flex h-13 items-center rounded-xl border border-border-strong bg-white px-7 text-[15px] font-bold text-primary transition-colors hover:bg-surface-info"
						>
							Ver cómo funciona
						</a>
					</div>
					<p class="reveal mt-4 text-sm text-text-caption" style="--reveal-delay: 320ms">
						¿Ya tienes cuenta? <a href="/login" class="font-semibold text-primary hover:underline">Inicia sesión</a>
					</p>
				</div>

				<div class="reveal" style="--reveal-delay: 200ms">
					<HeroDemo client:load />
				</div>
			</div>
		</section>

		<!-- TRUST STRIP -->
		<section class="border-y border-border bg-white" aria-label="Lo esencial">
			<ul class="mx-auto grid max-w-6xl grid-cols-2 gap-x-4 gap-y-5 px-4 py-6 sm:px-6 md:grid-cols-4">
				{trust.map((item) => (
					<li class="flex items-center justify-center gap-2.5 text-center text-sm font-semibold text-text-secondary md:justify-start">
						<item.icon className="h-5 w-5 shrink-0 text-secondary" strokeWidth={1.75} />
						{item.label}
					</li>
				))}
			</ul>
		</section>

		<!-- HOW IT WORKS -->
		<section id="como-funciona" class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
			<div class="reveal mx-auto max-w-2xl text-center">
				<p class="text-sm font-bold uppercase tracking-widest text-secondary">Cómo funciona</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">Tres pasos y tu tratamiento queda en orden</h2>
			</div>

			<ol class="relative mt-14 grid gap-6 md:grid-cols-3">
				<div class="absolute left-[16.66%] right-[16.66%] top-9 hidden h-0.5 bg-linear-to-r from-primary/30 via-secondary/40 to-primary/30 md:block" aria-hidden="true"></div>
				{steps.map((step, index) => (
					<li class="reveal relative rounded-3xl border border-border bg-white p-7 text-center shadow-sm transition-all hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/10" style={`--reveal-delay: ${index * 120}ms`}>
						<span class="relative mx-auto flex h-18 w-18 items-center justify-center rounded-2xl bg-linear-to-br from-primary to-secondary text-white shadow-lg shadow-primary/25">
							<step.icon className="h-8 w-8" strokeWidth={1.75} />
							<span class="absolute -right-2 -top-2 flex h-7 w-7 items-center justify-center rounded-full border-2 border-white bg-warning-strong text-xs font-bold text-white">
								{index + 1}
							</span>
						</span>
						<h3 class="mt-5 text-lg font-bold text-text">{step.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-text-secondary">{step.text}</p>
					</li>
				))}
			</ol>
		</section>

		<!-- FEATURES -->
		<section id="funciones" class="bg-surface-muted/60 py-20 lg:py-28">
			<div class="mx-auto max-w-6xl px-4 sm:px-6">
				<div class="reveal mx-auto mb-10 max-w-2xl text-center">
					<p class="text-sm font-bold uppercase tracking-widest text-secondary">Funciones</p>
					<h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">Todo lo que necesitas, sin complicarte</h2>
					<p class="mt-3 text-text-secondary">Explora cada una. Las maquetas son interactivas.</p>
				</div>
				<div class="reveal">
					<FeatureTabs client:visible />
				</div>
			</div>
		</section>

		<!-- PRIVACY -->
		<section id="privacidad" class="px-4 py-20 sm:px-6 lg:py-28">
			<div class="relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] bg-linear-to-br from-primary to-[#0a3f52] px-6 py-14 text-white sm:px-12">
				<div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-secondary/25 blur-3xl" aria-hidden="true"></div>
				<div class="relative">
					<div class="reveal max-w-2xl">
						<p class="text-sm font-bold uppercase tracking-widest text-success-soft">Privacidad</p>
						<h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Tu información de salud es tuya</h2>
						<p class="mt-3 leading-relaxed text-white/80">
							Una fórmula médica es información delicada. Por eso te damos el control y te contamos con claridad qué pasa con ella.
						</p>
					</div>
					<ul class="mt-10 grid gap-4 sm:grid-cols-2">
						{privacy.map((item, index) => (
							<li class="reveal rounded-2xl border border-white/15 bg-white/10 p-5 backdrop-blur-sm transition-colors hover:bg-white/15" style={`--reveal-delay: ${index * 90}ms`}>
								<span class="flex h-10 w-10 items-center justify-center rounded-xl bg-white/15">
									<item.icon className="h-5 w-5" strokeWidth={1.75} />
								</span>
								<h3 class="mt-4 font-bold">{item.title}</h3>
								<p class="mt-1.5 text-sm leading-relaxed text-white/75">{item.text}</p>
							</li>
						))}
					</ul>
					<a href="/privacy-policy" class="reveal mt-8 inline-flex items-center gap-2 text-sm font-bold text-success-soft hover:text-white">
						Leer la política de privacidad completa <ArrowRight className="h-4 w-4" strokeWidth={2.5} />
					</a>
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section id="preguntas" class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 lg:pb-28">
			<div class="reveal mx-auto mb-10 max-w-2xl text-center">
				<p class="text-sm font-bold uppercase tracking-widest text-secondary">Preguntas frecuentes</p>
				<h2 class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">Lo que más nos preguntan</h2>
			</div>
			<div class="reveal">
				<Faq client:visible />
			</div>
		</section>

		<!-- FINAL CTA -->
		<section class="px-4 pb-20 sm:px-6">
			<div class="reveal mx-auto max-w-4xl rounded-[2rem] border border-border bg-linear-to-br from-surface-info to-white p-10 text-center shadow-xl shadow-primary/5 sm:p-14">
				<h2 class="text-balance text-3xl font-bold tracking-tight text-text sm:text-4xl">Empieza hoy a cuidar tus tomas</h2>
				<p class="mx-auto mt-3 max-w-xl text-text-secondary">Crea tu cuenta, agrega tu primer medicamento y deja que MediTrack se encargue de los recordatorios.</p>
				<div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
					<a href="/register" class="flex h-13 items-center rounded-xl bg-primary px-8 text-[15px] font-bold text-white shadow-lg shadow-primary/30 transition-all hover:-translate-y-0.5 hover:bg-primary-hover">
						Crear mi cuenta
					</a>
					<a href="/login" class="flex h-13 items-center rounded-xl px-6 text-[15px] font-bold text-primary hover:bg-white">Ya tengo cuenta</a>
				</div>
			</div>
		</section>
	</main>

	<footer class="border-t border-border bg-white">
		<div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-text-caption sm:px-6 md:flex-row md:items-center md:justify-between">
			<div>
				<p class="font-bold text-primary">MediTrack</p>
				<p class="mt-1 max-w-md text-xs leading-relaxed">
					Herramienta de apoyo para organizar tus medicamentos. No reemplaza la indicación de tu médico ni de tu profesional de salud.
				</p>
			</div>
			<nav aria-label="Legal" class="flex flex-wrap gap-x-6 gap-y-2 font-semibold text-text-secondary">
				<a href="/privacy-policy" class="hover:text-primary">Política de privacidad</a>
				<a href="/caregiver-consent" class="hover:text-primary">Monitoreo por cuidadores</a>
				<a href="/login" class="hover:text-primary">Iniciar sesión</a>
			</nav>
		</div>
	</footer>

	<script is:inline>
		// Fade sections in as they scroll into view. Elements already on screen reveal immediately.
		(function () {
			var items = document.querySelectorAll('.reveal');
			if (!('IntersectionObserver' in window)) {
				items.forEach(function (el) { el.classList.add('is-visible'); });
				return;
			}
			var observer = new IntersectionObserver(function (entries) {
				entries.forEach(function (entry) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
			items.forEach(function (el) { observer.observe(el); });
		})();
	</script>
</Layout>
